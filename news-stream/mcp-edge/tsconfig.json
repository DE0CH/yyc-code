{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "strict": true,
    "lib": ["ES2022", "DOM"], "types": ["node"],
    "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "paths": { "postgres": ["./node_modules/postgres"] }
  },
  "include": ["src"]
}
