# The Talos release yyc-talos runs (README "Node work"). talos.sh gen renders new nodes with it; the workflow
# talos-nodes.yml upgrades every node to it (one at a time) and, on its weekly run, commits the newest patch release
# of this minor here first. Bash syntax: sourced by talos.sh and node-work.sh.
TALOS_VERSION=v1.14.6
# Image Factory installer for the vanilla schematic (no extensions), the same for arm64 and amd64
TALOS_INSTALLER=factory.talos.dev/installer/376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba
