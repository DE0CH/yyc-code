// Worker yyc-ai-apps (src/index.js, apps/README.md) on YYC's own Cloudflare account, on the route
// ai.yyc-internal.com/apps/* behind the Access app "YYC AI apps" (news-stream/deploy/cloudflare/tofu/apps.tf).
// Deployed by .github/workflows/yyc-ai-apps.yml; the account id comes from CLOUDFLARE_ACCOUNT_ID at deploy.
{
  "name": "yyc-ai-apps",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // no workers.dev or preview address: the only way in is the route, behind Access
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM": "yyc-hk",
    // the Access app "YYC AI apps"'s audience tag (tofu output aud.apps)
    "ACCESS_AUD": "becadfc9b3c8ffecfd0a79ea10684ff9a622d0dc93c531592dcab6dbf7db64e1",
    "DOWNLOAD_NAME": "YYC-AI.apk"
  },
  "r2_buckets": [{ "binding": "APPS", "bucket_name": "yyc-ai-apps" }],
  "observability": { "enabled": true }
}
